# Dev only. For users: `npx -y @valoquang/kz-pgw-mcp init` writes ~/.config/kz-pgw/.env instead.
# Copy to .env and fill in. Empty = code default.

# --- Backoffice (staging) ---
KZ_USERNAME=
KZ_PASSWORD=
KZ_STAGING_DOMAIN=trykz.dev
KZ_PGW_ALLOW_WRITES=false
# KZ_TOTP_SECRET_<GROUP>=

# --- Staging Postgres ---
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PG_MCP_LABEL=

# --- SSH tunnel (empty SSH_HOST = direct) ---
SSH_HOST=
SSH_PORT=
SSH_USER=
SSH_PASSWORD=
# SSH_KEY_PATH=~/.ssh/id_ed25519

# --- VPN nudge (macOS) ---
PG_MCP_VPN_APP=
PG_MCP_VPN_GATEWAY=
