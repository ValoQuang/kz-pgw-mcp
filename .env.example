# Dev only. For users: `npx -y @s5tech/kz-pgw-mcp init` writes ~/.config/kz-pgw/.env instead.

# --- Backoffice (staging) ---
KZ_USERNAME=
KZ_PASSWORD=
KZ_STAGING_DOMAIN=trykz.dev
KZ_PGW_ALLOW_WRITES=false
# KZ_TOTP_SECRET_TPG1=

# --- Staging Postgres ---
PGHOST=
PGPORT=5432
PGDATABASE=kz-tpg1
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PG_MCP_LABEL=kz-api-global (staging)

# --- SSH tunnel (empty SSH_HOST = direct) ---
SSH_HOST=13.251.63.79
SSH_PORT=22
SSH_USER=ubuntu
SSH_PASSWORD=
# SSH_KEY_PATH=~/.ssh/id_ed25519

# --- VPN nudge (macOS) ---
PG_MCP_VPN_APP=NordLayer
PG_MCP_VPN_GATEWAY=s5tech-VPS
